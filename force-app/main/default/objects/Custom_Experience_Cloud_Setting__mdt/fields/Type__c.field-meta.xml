<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Type__c</fullName>
    <description>Determines which component this record configures. The Login component reads the record where Type is Login, and the Self Registration component reads the record where Type is Self Registration.</description>
    <externalId>false</externalId>
    <fieldManageability>SubscriberControlled</fieldManageability>
    <inlineHelpText>Set to Login or Self Registration. Only one record of each type should be active.</inlineHelpText>
    <label>Type</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Login</fullName>
                <default>true</default>
                <label>Login</label>
            </value>
            <value>
                <fullName>Self Registration</fullName>
                <default>false</default>
                <label>Self Registration</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
